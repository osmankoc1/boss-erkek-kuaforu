generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Customer {
  id                   String            @id @default(cuid())
  fullName             String
  phone                String            @unique
  email                String?
  notes                String?
  tag                  String            @default("normal")
  totalAppointments    Int               @default(0)
  completedCount       Int               @default(0)
  cancelledCount       Int               @default(0)
  lastVisitAt          DateTime?
  createdAt            DateTime          @default(now())
  mergedIntoCustomerId String?
  mergedAt             DateTime?
  appointments         Appointment[]
  sales                Sale[]
  payments             CustomerPayment[]
}

model Barber {
  id             String          @id @default(cuid())
  name           String
  bio            String?
  photoUrl       String?
  specialty      String?
  experienceYrs  Int             @default(0)
  calendarColor  String          @default("#c9762c")
  isActive       Boolean         @default(true)
  workerType     String          @default("OWNER")
  commissionRate Decimal         @default(0) @db.Decimal(5, 2)
  workingHours   WorkingHour[]
  exceptions     DateException[]
  appointments   Appointment[]
  sales          Sale[]
  payouts        BarberPayout[]
  createdAt      DateTime        @default(now())
}

model Service {
  id                  String               @id @default(cuid())
  name                String
  description         String?
  durationMinutes     Int
  price               Decimal              @db.Decimal(12, 2)
  isActive            Boolean              @default(true)
  displayOrder        Int                  @default(0)
  category            String               @default("Diğer")
  appointments        Appointment[]
  sales               Sale[]
  appointmentServices AppointmentService[]
  saleItems           SaleItem[]
  createdAt           DateTime             @default(now())
}

model WorkingHour {
  id        String  @id @default(cuid())
  barberId  String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  isOff     Boolean @default(false)
}

model DateException {
  id       String   @id @default(cuid())
  barberId String
  barber   Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  date     DateTime
  reason   String?
}

model Appointment {
  id                      String               @id @default(cuid())
  barberId                String
  barber                  Barber               @relation(fields: [barberId], references: [id])
  serviceId               String?
  service                 Service?             @relation(fields: [serviceId], references: [id])
  customerId              String
  customer                Customer             @relation(fields: [customerId], references: [id])
  date                    DateTime
  startTime               String
  endTime                 String
  status                  String               @default("pending")
  appointmentPrice        Decimal              @default(0) @db.Decimal(12, 2)
  notes                   String?
  reminderSent            Boolean              @default(false)
  googleEventId           String?
  verificationToken       String?              @unique
  verifiedAt              DateTime?
  verificationEmailSentAt DateTime?
  ipAddress               String?
  userAgent               String?
  riskScore               Int                  @default(0)
  riskReasons             String?
  createdAt               DateTime             @default(now())
  notifications           Notification[]
  sales                   Sale[]
  services                AppointmentService[]
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String
  action    String
  createdAt DateTime @default(now())

  @@index([key, action, createdAt])
}

model AppointmentService {
  id              String      @id @default(cuid())
  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?    @relation(fields: [serviceId], references: [id])
  serviceName     String
  category        String      @default("Diğer")
  price           Decimal     @db.Decimal(12, 2)
  durationMinutes Int
  createdAt       DateTime    @default(now())
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  description String
  buttonText  String?
  buttonLink  String?
  priority    Int      @default(0)
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  showOnHome  Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Notification {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          String
  recipient     String
  channel       String      @default("email")
  status        String      @default("sent")
  sentAt        DateTime    @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Sale {
  id                   String            @id @default(cuid())
  appointmentId        String?
  appointment          Appointment?      @relation(fields: [appointmentId], references: [id])
  customerId           String?
  customer             Customer?         @relation(fields: [customerId], references: [id])
  barberId             String
  barber               Barber            @relation(fields: [barberId], references: [id])
  serviceId            String?
  service              Service?          @relation(fields: [serviceId], references: [id])
  customerName         String
  customerPhone        String
  serviceName          String
  barberName           String
  listedPrice          Decimal           @default(0) @db.Decimal(12, 2)
  saleAmount           Decimal           @db.Decimal(12, 2)
  paidAmount           Decimal           @default(0) @db.Decimal(12, 2)
  remainingAmount      Decimal           @default(0) @db.Decimal(12, 2)
  paymentMethod        String            @default("CASH")
  saleStatus           String            @default("PAID")
  barberWorkerType     String
  barberCommissionRate Decimal           @default(0) @db.Decimal(5, 2)
  barberShare          Decimal           @default(0) @db.Decimal(12, 2)
  businessShare        Decimal           @default(0) @db.Decimal(12, 2)
  note                 String?
  saleDate             DateTime          @default(now())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  voidedAt             DateTime?
  voidReason           String?
  payments             CustomerPayment[]
  items                SaleItem[]
}

model SaleItem {
  id              String   @id @default(cuid())
  saleId          String
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service? @relation(fields: [serviceId], references: [id])
  serviceName     String
  category        String   @default("Diğer")
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int      @default(0)
  createdAt       DateTime @default(now())
}

model CustomerPayment {
  id            String    @id @default(cuid())
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  saleId        String?
  sale          Sale?     @relation(fields: [saleId], references: [id])
  amount        Decimal   @db.Decimal(12, 2)
  paymentMethod String    @default("CASH")
  note          String?
  paymentDate   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  /// Istemcinin urettigi benzersiz istek anahtari (FAZ 2 - Sira 9b).
  ///
  /// Nullable + unique bilerek secildi: Postgres unique index'te NULL'lar
  /// catismaz, dolayisiyla mevcut satirlar ve anahtar gondermeyen istemciler
  /// bozulmaz. Ayni kalip semada zaten var (Appointment.verificationToken).
  idempotencyKey String? @unique
}

/// Berbere GERCEKTEN odenen hakedis defteri (FAZ 2 - Sira 8).
///
/// Tahakkuk (hakedisin dogmasi) bu tabloda TUTULMAZ; `Sale.barberShare`
/// toplamindan turetilir. Burada yalnizca odenen para durur.
///   Tahakkuk = VOID olmayan satislarin barberShare toplami
///   Odenen   = bu tablonun amount toplami
///   Kalan    = Tahakkuk - Odenen
///
/// `periodStart`/`periodEnd` odemenin hangi calisma donemine ait oldugunu
/// KAYDEDER; tahakkuk bu alanlardan hesaplanmaz. `payoutDate` paranin fiilen
/// verildigi andir ve daima sunucu tarafindan atanir.
model BarberPayout {
  id            String   @id @default(cuid())
  barberId      String
  barber        Barber   @relation(fields: [barberId], references: [id])
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String   @default("CASH")
  periodStart   DateTime
  periodEnd     DateTime
  note          String?
  payoutDate    DateTime @default(now())
  createdAt     DateTime @default(now())

  /// Istemcinin urettigi benzersiz istek anahtari (FAZ 2 - Sira 9b).
  ///
  /// Nullable + unique bilerek secildi: Postgres unique index'te NULL'lar
  /// catismaz, dolayisiyla mevcut satirlar ve anahtar gondermeyen istemciler
  /// bozulmaz. Ayni kalip semada zaten var (Appointment.verificationToken).
  idempotencyKey String? @unique

  @@index([barberId, payoutDate])
  @@index([payoutDate])
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  category    String
  description String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
}

/// Merkezi denetim izi (FAZ 2 - Sira 10b).
///
/// "Kim neyi neye cevirdi" sorusunun tek cevap yeri. Model basina
/// `createdByUserId` alanlari bilinçli olarak SECILMEDI: onlar yalnizca son
/// degistireni tutar, ONCEKI DEGERI tutmaz.
///
/// Kurallar:
///   * Audit satiri ana islemle AYNI transaction'da yazilir; yazilamazsa ana
///     islem de commit edilmez.
///   * `changes` yalnizca DEGISEN alanlarin before/after degerini tutar;
///     komple satir snapshot'i saklanmaz.
///   * Alan secimi fail-closed whitelist ile yapilir (bkz. lib/audit.ts);
///     listede olmayan hicbir alan buraya giremez.
///   * Saklama suresi sinirsiz; otomatik silme yoktur.
///   * Gecmis veriye backfill yapilmaz.
model AuditLog {
  id       String @id @default(cuid())
  /// "Sale" | "CustomerPayment" | "BarberPayout" | "Expense" | "Customer" | "Appointment" | "Setting"
  entity   String
  entityId String
  /// "CREATE" | "UPDATE" | "VOID" | "DELETE" | "MERGE" | "STATUS_CHANGE"
  action   String

  /// Islemin kaynagi: "ADMIN" | "PUBLIC" | "SYSTEM".
  ///
  /// Ayri bir alan olmasi bilinçli: kaynak bilgisini `userEmail` icine
  /// sentinel metin olarak gommek, o alani hem kimlik hem etiket yapardi.
  source String

  /// Aktor -- yalnizca ADMIN kaynakli islemlerde dolu.
  ///
  /// `User` modeline FK YOKTUR: saklama suresi sinirsiz oldugu icin kullanici
  /// silinse bile denetim izi ayakta kalmalidir. E-posta o anki haliyle
  /// snapshot'lanir (ayni ilke Sale.barberName'de de uygulaniyor).
  userId    String?
  userEmail String?

  /// { "saleAmount": { "before": 1000, "after": 700 } }
  changes   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId, createdAt])
  @@index([entity, action, createdAt])
  @@index([source, createdAt])
}
